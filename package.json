{
  "name": "infraflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,worker,web \"npm run dev -w @infraflow/api\" \"npm run dev -w @infraflow/worker\" \"npm run dev -w @infraflow/web\"",
    "build": "prisma generate && tsc -p tsconfig.server.json && npm run build -w @infraflow/web",
    "start": "node --env-file=.env dist/apps/api/src/index.js",
    "start:worker": "node --env-file=.env dist/apps/worker/src/index.js",
    "typecheck": "tsc --noEmit && npm run typecheck -w @infraflow/web",
    "lint": "eslint .",
    "test": "tsx tests/migrate-test.ts && vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:generate": "prisma generate",
    "build:vercel": "node scripts/build-vercel.mjs",
    "db:seed:hosted": "tsx prisma/seed.ts",
    "test:hosted-config": "node --import tsx --test tests/hosted-config.unit.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.56.1",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "prisma": "^7.10.1",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^5.1.1"
  }
}
